{
  "name": "@configure-env/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "The typed client of the local configure-env API: fetch functions and React Query hooks generated by orval",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "gen:api": "tsx --tsconfig tsconfig.json scripts/gen-api.ts"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@configure-env/api": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "orval": "8.41.0",
    "react": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite-plus": "catalog:"
  }
}
