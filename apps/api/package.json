{
  "name": "@configure-env/api",
  "version": "0.0.0",
  "private": true,
  "description": "The local configure-env HTTP API: a token-protected NestJS server over a project's schema and env files",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vp test run",
    "build": "tsdown --config-loader native",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "launch-editor": "2.14.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@configure-env/core": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsdown": "0.23.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
