{
  "name": "@elvisgastelum/configure-env",
  "version": "0.0.0",
  "private": true,
  "description": "Configure, check and edit env files from a schema, interactively or in CI",
  "keywords": [
    "env",
    "dotenv",
    "environment",
    "configuration",
    "cli",
    "schema"
  ],
  "license": "MIT",
  "author": "Elvis Gastelum",
  "repository": "github:elvisgastelum/configure-env",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "start": "tsx src/cli.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.0",
    "vitest": "^5.0.3"
  }
}
