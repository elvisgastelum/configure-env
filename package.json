{
  "name": "@elvisgastelum/configure-env",
  "version": "0.0.0",
  "description": "Configure, check and edit env files from a schema, interactively or in CI",
  "keywords": [
    "env",
    "dotenv",
    "environment",
    "configuration",
    "cli",
    "schema",
    "env-file",
    "validation",
    "ci"
  ],
  "license": "MIT",
  "author": "Elvis Gastelum",
  "homepage": "https://github.com/elvisgastelum/configure-env#readme",
  "bugs": {
    "url": "https://github.com/elvisgastelum/configure-env/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elvisgastelum/configure-env.git"
  },
  "type": "module",
  "sideEffects": [
    "./dist/cli.js"
  ],
  "bin": {
    "configure-env": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./schema/env.schema.v1.json",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "start": "tsx src/cli.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "schema:generate": "tsx scripts/generate-json-schema.ts",
    "schema:check": "tsx scripts/generate-json-schema.ts --check",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "smoke": "bash scripts/pack-smoke.sh"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.0",
    "vitest": "^5.0.3"
  }
}
