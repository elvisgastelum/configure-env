{
  "name": "configure-env-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26"
  },
  "scripts": {
    "dev": "pnpm --filter @elvisgastelum/configure-env dev",
    "start": "pnpm --filter @elvisgastelum/configure-env start",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "vp run -r typecheck",
    "test": "vp run -r test",
    "e2e": "pnpm --filter @configure-env/e2e test:e2e",
    "e2e:screenshots": "pnpm --filter @configure-env/e2e screenshots",
    "build": "vp run -r build",
    "storybook": "pnpm --filter @configure-env/design-system storybook",
    "build-storybook": "pnpm --filter @configure-env/design-system build-storybook",
    "test:storybook": "pnpm --filter @configure-env/design-system test:storybook",
    "storybook:web": "pnpm --filter @configure-env/web storybook",
    "build-storybook:web": "pnpm --filter @configure-env/web build-storybook",
    "schema:generate": "pnpm --filter @elvisgastelum/configure-env schema:generate",
    "schema:check": "vp run @elvisgastelum/configure-env#schema:check",
    "gen:api": "pnpm --filter @configure-env/api-client gen:api",
    "gen:api:check": "vp run @configure-env/api-client#gen:api:check",
    "smoke": "pnpm --filter @elvisgastelum/configure-env smoke",
    "link:local": "pnpm --filter @elvisgastelum/configure-env link:local",
    "relink:local": "vp run -r --no-cache build && pnpm --filter @elvisgastelum/configure-env exec npm link",
    "unlink:local": "pnpm --filter @elvisgastelum/configure-env unlink:local",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "typescript": "~6.0.3",
    "vite-plus": "catalog:"
  }
}
