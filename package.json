{
  "name": "configure-env-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @elvisgastelum/configure-env dev",
    "start": "pnpm --filter @elvisgastelum/configure-env start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "storybook": "pnpm --filter @configure-env/design-system storybook",
    "build-storybook": "pnpm --filter @configure-env/design-system build-storybook",
    "test:storybook": "pnpm --filter @configure-env/design-system test:storybook",
    "schema:generate": "pnpm --filter @elvisgastelum/configure-env schema:generate",
    "schema:check": "pnpm --filter @elvisgastelum/configure-env schema:check",
    "gen:api": "pnpm --filter @configure-env/api-client gen:api",
    "gen:api:check": "pnpm --filter @configure-env/api-client gen:api:check",
    "smoke": "pnpm --filter @elvisgastelum/configure-env smoke",
    "link:local": "pnpm --filter @elvisgastelum/configure-env link:local",
    "unlink:local": "pnpm --filter @elvisgastelum/configure-env unlink:local",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.0"
  }
}
