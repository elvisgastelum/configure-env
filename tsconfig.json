{
  // Self-contained: these are the elvisgastelum.com base options, inlined so
  // the repo needs no parent tsconfig.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // tsx runs the sources directly; tsc only type-checks them.
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "scripts"]
}
